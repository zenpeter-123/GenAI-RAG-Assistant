# ==========================================
# OpenAI API Configuration
# ==========================================
# Kötelező: Az OpenAI API kulcsod (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ==========================================
# Application Settings
# ==========================================
# Az alkalmazás neve (megjelenik a Swagger UI-on)
PROJECT_NAME=Enterprise GenAI Document Assistant

# Az API végpontok prefixe (pl. /api/v1/chat)
API_V1_STR=/api/v1

# ==========================================
# AI Models
# ==========================================
# A szövegbeágyazáshoz (embeddings) használt modell
EMBEDDING_MODEL=text-embedding-3-small

# A válaszgeneráláshoz használt LLM
DEFAULT_MODEL=gpt-4o-mini

# ==========================================
# Storage
# ==========================================
# A ChromaDB vektoros adatbázis mentési mappája
CHROMA_PERSIST_DIR=./chroma_db